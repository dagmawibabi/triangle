<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this phone itself: the video player streams Telegram
     videos through a local proxy (lib/features/movies/tg_stream.dart).
     Everything else keeps Android's default (HTTPS only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
